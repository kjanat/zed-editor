#!/usr/bin/env python3
"""Claude Code PreToolUse hook that runs every Bash command through sandbox-exec."""

import json
import shlex
import sys
from pathlib import Path


def main() -> None:
    work = sys.argv[1]
    event = json.load(sys.stdin)
    tool_input = event.get("tool_input")
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    if not isinstance(command, str):
        json.dump(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": "Bash input has no command string.",
                }
            },
            sys.stdout,
        )
        return
    wrapper = Path(__file__).resolve().with_name("sandbox-exec")
    updated = dict(tool_input)
    updated["command"] = (
        f"SYNC_WORK={shlex.quote(work)} {shlex.quote(str(wrapper))} {shlex.quote(command)}"
    )
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "allow",
                "permissionDecisionReason": "Runs in the candidate sandbox.",
                "updatedInput": updated,
            }
        },
        sys.stdout,
    )


if __name__ == "__main__":
    main()
