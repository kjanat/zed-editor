# Prevent GitHub from displaying comments within JSON files as errors.
*.json linguist-language=JSON-with-Comments
**/.zed/*.json linguist-language=JSON-with-Comments
assets/keymaps/**/*.json linguist-language=JSON-with-Comments
assets/settings/*.json linguist-language=JSON-with-Comments
crates/grammars/src/*/semantic_token_rules.json linguist-language=JSON-with-Comments
crates/task/test_data/*.json linguist-language=JSON-with-Comments

# Ensure the WSL script always has LF line endings, even on Windows
crates/zed/resources/windows/zed.sh text eol=lf
